DATABASE_URL="mysql://crm_user:crm_password@localhost:3306/crm_db"
# Optional: enable prisma migrate dev without CREATE DATABASE permission.
# SHADOW_DATABASE_URL="mysql://crm_user:crm_password@localhost:3306/crm_shadow_db"
PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
SESSION_SECRET="change-this-session-secret"
ENCRYPTION_KEY=32-byte-or-longer-random-secret-key
FRONTEND_ORIGIN="http://localhost:5173"
# Optional comma-separated origins for Vercel preview/production URLs.
FRONTEND_ORIGINS="http://localhost:5173,https://ch-119-crm-frontend.vercel.app"
# Use false only for local HTTP testing. Keep true/empty in HTTPS deployments.
COOKIE_SECURE=false
