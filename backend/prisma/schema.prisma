generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  name         String   @db.VarChar(100)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                  Int      @id @default(autoincrement())
  name                String   @db.VarChar(100)
  phoneEncrypted      String   @db.Text
  phoneHash           String   @db.VarChar(64)
  addressEncrypted    String   @db.Text
  productCategory     String   @db.VarChar(50)
  productType         String   @db.VarChar(100)
  productBrand        String?  @db.VarChar(100)
  productCount        Int      @default(1)
  estimateRequestDate DateTime?
  workDate            DateTime?
  workStartTime       String?  @db.VarChar(5)
  workEndTime         String?  @db.VarChar(5)
  estimatePrice       Int?
  finalPrice          Int?
  deposit             Int?
  balance             Int?
  paymentMethod       String?  @db.VarChar(50)
  paymentStatus       String   @db.VarChar(50)
  invoiceIssued       String?  @db.VarChar(10)
  customerStatus      String   @db.VarChar(50)
  memo                String?  @db.Text
  specialNote         String?  @db.Text
  revisitDate         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  revenues            Revenue[]

  @@index([phoneHash])
  @@index([productCategory])
  @@index([customerStatus])
  @@index([paymentStatus])
  @@index([workDate])
  @@index([revisitDate])
}

model Revenue {
  id               Int       @id @default(autoincrement())
  date             DateTime
  customerId       Int?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  category         String    @db.VarChar(100)
  amount           Int
  paymentMethod    String?   @db.VarChar(50)
  memo             String?   @db.Text
  sourceType       String    @default("MANUAL") @db.VarChar(50)
  sourceCustomerId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceType, sourceCustomerId])
  @@index([date])
  @@index([category])
  @@index([paymentMethod])
  @@index([customerId])
}

model Expense {
  id        Int      @id @default(autoincrement())
  date      DateTime
  category  String   @db.VarChar(100)
  amount    Int
  vendor    String?  @db.VarChar(100)
  memo      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([vendor])
}
