generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                  Int      @id @default(autoincrement())
  name                String
  phoneEncrypted      String
  phoneHash           String
  addressEncrypted    String
  productCategory     String
  productType         String
  productBrand        String?
  productCount        Int      @default(1)
  estimateRequestDate DateTime?
  workDate            DateTime?
  workStartTime       String?
  workEndTime         String?
  estimatePrice       Int?
  finalPrice          Int?
  deposit             Int?
  balance             Int?
  paymentMethod       String?
  paymentStatus       String
  customerStatus      String
  memo                String?
  specialNote         String?
  revisitDate         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([phoneHash])
  @@index([productCategory])
  @@index([customerStatus])
  @@index([paymentStatus])
  @@index([workDate])
  @@index([revisitDate])
}
